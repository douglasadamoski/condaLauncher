# condaLauncher site settings -- copy to ~/.config/condaLauncher/site.env
# Machine-specific, so it never goes into a tool's repo. key=value; parsed, not sourced.

# Path to mamba/conda/micromamba when it is not found automatically.
#CONDA=/opt/miniforge3/bin/mamba

# Extra folders holding conda envs (space separated), in addition to ~/.condarc envs_dirs.
#ENV_DIRS=/data/shared/conda/envs

# Env names the launcher must never install packages into (shared by many people).
#SHARED_ENVS=lab_base

# chmod applied to files the launcher writes (state, logs, reports). Empty = umask.
#FILE_MODE=666

# Look: THEME=night|day  BACKGROUND=auto|dark|light  MOUSE=1|0  ASCII=0|1
#THEME=night
#MOUSE=1
